# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=PANGEA API
APP_VERSION=0.1.0
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/your_db_name

# ── Blockchain ────────────────────────────────────────────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Block the contract was deployed at — listener will start scanning from here
LISTENER_START_BLOCK=0
# Seconds between polling cycles
LISTENER_POLL_INTERVAL=5

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Sends OTP login codes and notification emails (donation received, impact update)
GMAIL_USER=your_sender@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ── Firebase (optional — push delivery is dormant) ────────────────────────────
# Path to the service-account JSON downloaded from Firebase console
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
